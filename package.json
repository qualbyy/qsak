{
  "name": "qsak",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quick Swiss Army Knife — local-first online/offline format converter & inspector",
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=1024\" tsc -b && cross-env UV_THREADPOOL_SIZE=1 vite build",
    "preview": "vite preview",
    "test": "cross-env NODE_OPTIONS=\"--max-old-space-size=512\" UV_THREADPOOL_SIZE=1 vitest run --maxWorkers=1 --fileParallelism=false",
    "tauri": "tauri",
    "rust:test": "CARGO_BUILD_JOBS=1 cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.0.1",
    "@jsquash/webp": "^1.5.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "7z-wasm": "^1.2.0",
    "comlink": "^4.4.2",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.0.0",
    "fflate": "^0.8.3",
    "file-type": "^22.3.0",
    "js-yaml": "^4.1.0",
    "libheif-js": "^1.23.5",
    "lucide-react": "^0.511.0",
    "marked": "^15.0.0",
    "papaparse": "^5.5.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "smol-toml": "^1.6.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/js-yaml": "^4.0.9",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.4.1",
    "cross-env": "^10.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.1.3"
  }
}
